{
  "name": "command-lab",
  "version": "0.1.0",
  "description": "실제 CLI 환경(Docker 컨테이너)에서 상황 기반 시나리오로 명령어를 연습하는 실습장",
  "type": "module",
  "bin": {
    "lab": "bin/lab.js"
  },
  "scripts": {
    "lab": "node bin/lab.js",
    "web": "node bin/lab.js web --open",
    "validate": "node bin/lab.js validate",
    "test": "node bin/lab.js validate && node bin/lab.js test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "dockerode": "^4.0.2",
    "marked": "^15.0.0",
    "tar-fs": "^3.1.3",
    "ws": "^8.18.0",
    "yaml": "^2.6.0"
  }
}
